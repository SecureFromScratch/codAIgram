import { after, before, test } from 'node:test';
import assert from 'node:assert/strict';
import { randomUUID } from 'node:crypto';
import { createLocalFirestore, FirestoreClassRepository } from '../../server/dist/firestore-repository.js';
import { INITIAL_CLASSES } from '../../server/dist/memory-class-repository.js';
import { createApp } from '../../server/dist/app.js';

let database;
let server;
let base;
const collection = `codaigram_test_${randomUUID().replaceAll('-', '')}`;
const added = { name: 'IntegrationAdded', methods: ['save(value: string)'], relations: [{ kind: 'OWNS', name: 'items', target: 'Item', many: true }], isPartial: false };

before(async () => {
  database = createLocalFirestore();
  for (const item of INITIAL_CLASSES) await database.collection(collection).doc(item.name).create(item);
  server = await new Promise(resolve => { const instance = createApp(new FirestoreClassRepository(database, collection)).listen(0, '127.0.0.1', () => resolve(instance)); });
  const address = server.address();
  assert.ok(address && typeof address !== 'string');
  base = `http://127.0.0.1:${address.port}/api/classesDetails`;
});
after(async () => {
  if (server) await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
  if (database) {
    for (const item of INITIAL_CLASSES) await database.collection(collection).doc(item.name).delete();
    await database.collection(collection).doc(added.name).delete();
    await database.terminate();
  }
});
test('updateClasses persists a batch which classesDetails can read', async () => {
  const changed = { name: 'Class', methods: ['inspect()'], relations: [], isPartial: false };
  const update = await fetch(base.replace('classesDetails', 'updateClasses'), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify([added, changed]) });
  assert.equal(update.status, 200);
  assert.deepEqual(await update.json(), { updated: 2 });
  const read = await fetch(base, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ classNames: [added.name, changed.name] }) });
  assert.deepEqual(await read.json(), [added, changed]);
});
test('HTTP route loads stored documents and preserves requested order and duplicates', async () => {
  const response = await fetch(base, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ classNames: ['Class', 'Missing', 'ClassDiagram', 'Class'] }) });
  assert.equal(response.status, 200);
  const result = await response.json();
  assert.deepEqual(result.map(item => item.name), ['Class', 'ClassDiagram', 'Class']);
  assert.equal(result[1].methods.length, 4);
  assert.deepEqual(result[1].relations, INITIAL_CLASSES[0].relations);
});
