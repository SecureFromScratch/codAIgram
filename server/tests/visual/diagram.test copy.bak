test('multiple classes update the graph and ownership reconnects when a target is renamed', async () => {
  const { editor, text } = await resetOwnershipEditor();
  const extra = '\n\nClass\n  isPartial : bool\n  modifications: ModificationRecord[]\n  addModification(ModificationRecord)\n\nModificationRecord\n  by: [AI, Human, Scan]\n  at: datetime';
  const source = text + extra;
  await editor.fill(source);
  await page.waitForFunction(() => [...document.querySelectorAll('.joint-type-standard-headeredrectangle text:first-of-type')].some(element => element.textContent === 'ModificationRecord'));
  assert.equal(await editor.locator('.dsl-error').count(), 0);
  const classBox = page.locator('.joint-type-standard-headeredrectangle').filter({ hasText: 'isPartial' });
  assert.ok((await classBox.textContent()).includes('modifications'));
  await editor.fill(source.replace('isPartial : bool', 'isComplete : bool'));
  await page.waitForFunction(() => [...document.querySelectorAll('.joint-type-standard-headeredrectangle')].some(item => item.textContent.includes('isComplete : bool')));
  await editor.fill(source);
  await editor.fill(source.replace('\n\nClass\n', '\n\nClass1\n'));
  await page.waitForFunction(() => [...document.querySelectorAll('.joint-type-standard-rectangle text')].some(item => item.textContent === 'Class'));
  assert.ok((await page.locator('.joint-type-standard-headeredrectangle').allTextContents()).some(item => item.includes('Class1')));
  await editor.fill(source);
  await page.waitForFunction(() => document.querySelectorAll('.joint-type-standard-rectangle').length === 0);
  await editor.fill(source.replace('\n\nClass\n', '\n\nClassDiagram\n'));
  const conflict = editor.locator('.dsl-error').filter({ hasText: 'ClassDiagram' });
  await conflict.first().waitFor();
  assert.match(await conflict.first().getAttribute('title'), /Duplicate class name/);
  await conflict.first().hover();
  await page.locator('.dsl-diagnostic-tooltip').filter({ hasText: 'Duplicate class name: ClassDiagram.' }).waitFor();
  await editor.fill(source.replace('\n\nClass\n', '\nClass\n'));
  const separator = editor.locator('.dsl-error').filter({ hasText: 'Class' });
  await separator.first().waitFor();
  assert.match(await separator.first().getAttribute('title'), /blank line/);
});

test('editor-visible classes have a filled circular eye badge at the top left', async () => {
  const { editor, text } = await resetOwnershipEditor();
  await editor.fill(`${text}\n\nClass\n  isPartial: bool`);
  const badges = page.locator('[data-eye-badge]');
  await page.waitForFunction(() => document.querySelectorAll('[data-eye-badge]').length === 2);
  for (const badge of await badges.all()) {
    const info = await badge.evaluate(element => {
      const circle = element.querySelector('circle');
      const box = element.closest('.joint-element')?.querySelector('rect');
      const bounds = element.getBoundingClientRect();
      const boxBounds = box?.getBoundingClientRect();
      return { text: element.textContent, circle: circle && getComputedStyle(circle).fill, width: bounds.width, height: bounds.height, left: bounds.left, top: bounds.top, boxLeft: boxBounds?.left, boxTop: boxBounds?.top };
    });
    assert.ok(info.text.includes('👁'));
    assert.ok(info.circle && info.circle !== 'none');
    assert.ok(Math.abs(info.width - info.height) <= 2 && info.width <= 32, 'badge is a small circle');
    assert.ok(Math.abs(info.left - info.boxLeft) <= info.width && Math.abs(info.top - info.boxTop) <= info.height, 'badge is at the class box top left');
  }
});

