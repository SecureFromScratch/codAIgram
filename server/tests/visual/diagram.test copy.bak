const SECONDARY_CLASSES = [
  { name: 'Modification', source: 'Modification\n  by: string\n  at: datetime', members: ['by: string', 'at: datetime'] },
  { name: 'ModificationHistory', source: 'ModificationHistory\n  modifications : Modification[]\n  push(newModification: Modification)\n  compact(maxModsToKeep: positive)', members: ['modifications : Modification[]', 'push', 'compact'] }
];

async function isolateSecondaryClass(name) {
  const { editor, text } = await resetOwnershipEditor();
  await editor.fill(`${text}\n\n${SECONDARY_CLASSES.map(item => item.source).join('\n\n')}`);
  const target = page.locator(`[data-class-name="${name}"]`);
  await target.waitFor();
  await target.dblclick();
  const selected = SECONDARY_CLASSES.find(item => item.name === name);
  await page.waitForFunction(expected => [...document.querySelectorAll('.cm-content .cm-line')].map(line => line.textContent).join('\n') === expected, selected.source);
  return { editor, selected };
}

for (const fixture of SECONDARY_CLASSES) {
  test(`${fixture.name}: isolated class has correct header, body, bounds, highlighting and badge`, async () => {
    const { editor } = await isolateSecondaryClass(fixture.name);
    assert.equal(await editor.locator('.dsl-error').count(), 0);
    assert.equal(await editor.locator('.dsl-class-name').innerText(), fixture.name);
    assert.equal(await page.locator('[data-eye-badge]').count(), 1);
    const geometry = await page.locator(`[data-class-name="${fixture.name}"]`).evaluate(element => {
      const [body, header] = element.querySelectorAll('rect');
      const [title, contents] = element.querySelectorAll('text');
      return { body: body.getBoundingClientRect().toJSON(), header: header.getBoundingClientRect().toJSON(), title: title.getBoundingClientRect().toJSON(), contents: contents.getBoundingClientRect().toJSON(), titleText: title.textContent, bodyText: contents.textContent, rows: [...contents.querySelectorAll(':scope > tspan')].map(row => ({ text: row.textContent, rect: row.getBoundingClientRect().toJSON() })) };
    });
    assert.equal(geometry.titleText, fixture.name);
    assert.ok(geometry.body.width <= 200);
    assert.ok(geometry.title.top >= geometry.header.top && geometry.title.bottom <= geometry.header.bottom);
    assert.ok(geometry.contents.top >= geometry.header.bottom && geometry.contents.bottom <= geometry.body.bottom);
    assert.equal(geometry.rows.length, fixture.members.length);
    for (const [index, expected] of fixture.members.entries()) {
      const row = geometry.rows[index];
      assert.ok(row.text === expected || (row.text.endsWith('…') && expected.startsWith(row.text.slice(0, -1))));
      assert.ok(row.rect.left >= geometry.body.left && row.rect.right <= geometry.body.right);
    }
  });

  test(`${fixture.name}: property edits, invalid syntax and title edits update only this class`, async () => {
    const { editor, selected } = await isolateSecondaryClass(fixture.name);
    const property = fixture.name === 'Modification' ? 'by: string' : 'modifications : Modification[]';
    await editor.fill(selected.source.replace(property, 'updated: boolean'));
    await page.waitForFunction(name => document.querySelector(`[data-class-name="${name}"]`)?.textContent.includes('updated: boolean'), fixture.name);
    assert.equal(await page.locator('[data-class-name="ClassDiagram"]').count(), 1);
    await editor.fill(selected.source.replace(property, 'updated boolean'));
    await assertRedWavyError(editor, 'updated boolean');
    await editor.fill(selected.source.replace(property, 'updated:'));
    await assertRedWavyError(editor, 'updated:');
    await editor.fill(selected.source.replace(/^\w+/, `${fixture.name}Renamed`));
    await page.locator(`[data-class-name="${fixture.name}Renamed"]`).waitFor();
    await editor.fill(selected.source.replace(/^\w+/, ''));
    await editor.locator('.dsl-missing-class').waitFor();
  });

  test(`${fixture.name}: adding, renaming, deleting and undoing a method updates its own graph box`, async () => {
    const { editor, selected } = await isolateSecondaryClass(fixture.name);
    const original = `${selected.source}\n  inspect(value: string)`;
    await editor.fill(original);
    const box = page.locator(`[data-class-name="${fixture.name}"]`);
    await page.waitForFunction(name => document.querySelector(`[data-class-name="${name}"]`)?.textContent.includes('inspect'), fixture.name);
    await editor.fill(original.replace('inspect(value: string)', 'review(label: number, active: boolean)'));
    const method = box.locator('[data-method-tooltip^="review("]');
    await method.waitFor();
    assert.equal(await method.getAttribute('data-method-tooltip'), 'review(label, active)\n-label: number\n-active: boolean');
    await method.hover();
    await page.getByRole('tooltip').waitFor();
    const current = original.replace('inspect(value: string)', 'review(label: number, active: boolean)');
    await editor.fill(current.replace('  review', ' review'));
    await assertRedWavyError(editor, 'review(label: number, active: boolean)');
    await editor.fill(current.replace('review(label: number, active: boolean)', 'review(label number)'));
    await assertRedWavyError(editor, 'review(label number)');
    await editor.fill(current);
    const line = editor.locator('.cm-line').filter({ hasText: 'review(label: number, active: boolean)' });
    await line.click(); await page.keyboard.press('Home'); await page.keyboard.press('Shift+End'); await page.keyboard.press('Backspace');
    await page.waitForFunction(name => !document.querySelector(`[data-class-name="${name}"]`)?.textContent.includes('review'), fixture.name);
    await page.keyboard.press('Control+z');
    await page.waitForFunction(expected => [...document.querySelectorAll('.cm-content .cm-line')].map(item => item.textContent).join('\n') === expected, current);
    await box.locator('[data-method-tooltip^="review("]').waitFor();
  });

  test(`${fixture.name}: ownership edits update the correct connector and multiplicity`, async () => {
    const { editor, selected } = await isolateSecondaryClass(fixture.name);
    const relationship = `${selected.source}\nOWNS entries: Entry[]`;
    await editor.fill(relationship);
    await page.waitForFunction(() => [...document.querySelectorAll('.joint-link text')].some(item => item.textContent === 'entries'));
    assert.equal(await page.locator('[data-class-name="Entry"]').count(), 1);
    assert.equal(await page.locator('.joint-link').count(), 2);
    await editor.fill(relationship.replace('Entry[]', 'Entry'));
    await page.waitForFunction(() => [...document.querySelectorAll('.joint-link')].some(link => [...link.querySelectorAll('text')].map(item => item.textContent).join('|') === 'entries'));
    await editor.fill(relationship.replace('entries: Entry[]', 'Entry[]'));
    await page.waitForFunction(() => ![...document.querySelectorAll('.joint-link text')].some(item => item.textContent === 'entries'));
    assert.equal(await page.locator('.joint-link').count(), 2);
    await editor.fill(relationship.replace('OWNS entries: Entry[]', 'OWX entries: Entry[]'));
    await page.waitForFunction(() => document.querySelectorAll('.joint-link').length === 1);
    await assertRedWavyError(editor, 'entries: Entry[]');
    await editor.fill(relationship);
    await page.waitForFunction(() => document.querySelectorAll('.joint-link').length === 2);
    await editor.fill(relationship.replace('Entry[]', ''));
    await page.waitForFunction(() => [...document.querySelectorAll('.joint-type-standard-rectangle text')].some(item => item.textContent === '?'));
    await editor.fill(relationship);
    await page.waitForFunction(() => document.querySelectorAll('.joint-link').length === 2);
    await editor.fill(selected.source);
    await page.waitForFunction(() => document.querySelectorAll('.joint-link').length === 1);
    assert.equal(await page.locator('[data-class-name="Entry"]').count(), 0);
  });

  test(`${fixture.name}: method tooltip stays inside the panel at its top and bottom edges`, async () => {
    const { editor, selected } = await isolateSecondaryClass(fixture.name);
    await editor.fill(`${selected.source}\n  inspect(value: string)`);
    await page.setViewportSize({ width: 1600, height: 440 });
    try {
      for (const edge of ['top', 'bottom']) {
        await page.locator('.canvas').evaluate((canvas, { name, side }) => {
          const box = canvas.querySelector(`[data-class-name="${name}"] rect`).getBoundingClientRect();
          const panel = canvas.getBoundingClientRect();
          canvas.scrollTop += side === 'top' ? box.top - panel.top - 2 : box.bottom - panel.bottom + 2;
        }, { name: fixture.name, side: edge });
        await page.locator(`[data-class-name="${fixture.name}"] [data-method-tooltip^="inspect("]`).hover();
        const tooltip = page.getByRole('tooltip');
        await tooltip.waitFor();
        const fits = await tooltip.evaluate(element => {
          const tip = element.getBoundingClientRect();
          const panel = element.closest('.graph-pane').getBoundingClientRect();
          return tip.top >= panel.top && tip.bottom <= panel.bottom && tip.left >= panel.left && tip.right <= panel.right && tip.top >= 0 && tip.bottom <= window.innerHeight && tip.left >= 0 && tip.right <= window.innerWidth && element.scrollHeight <= element.clientHeight + 1;
        });
        assert.ok(fits, `tooltip fits at the ${edge} edge`);
        assert.ok((await tooltip.textContent()).includes('value'));
        await page.mouse.move(2, 2);
      }
    } finally {
      await page.setViewportSize({ width: 1600, height: 1000 });
      await page.locator('.canvas').evaluate(element => { element.scrollTop = 0; });
    }
  });
}
