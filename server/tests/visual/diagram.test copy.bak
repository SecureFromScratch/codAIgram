  }
});

test('a hidden existing class is a conflict until @ restores its saved definition', async () => {
  const { editor, text } = await resetOwnershipEditor();
  const existing = 'ExistingClass\n  field: string\n  run(value: number)';
  await editor.fill(`${text}\n\n${existing}`);
  await page.locator('[data-class-name="ClassDiagram"]').dblclick();
  await page.waitForFunction(expected => [...document.querySelectorAll('.cm-content .cm-line')].map(line => line.textContent).join('\n') === expected, text);
  await editor.fill(`${text}\n\nExistingClass`);
  const conflict = editor.locator('.dsl-error').filter({ hasText: 'ExistingClass' });
  await conflict.first().waitFor();
  const style = await conflict.first().evaluate(element => ({ style: getComputedStyle(element).textDecorationStyle, color: getComputedStyle(element).textDecorationColor }));
  assert.equal(style.style, 'wavy');
  assert.equal(style.color, 'rgb(220, 38, 38)');
  await editor.press('End');
  await page.keyboard.type('@');
  await page.waitForFunction(expected => [...document.querySelectorAll('.cm-content .cm-line')].map(line => line.textContent).join('\n') === expected, `${text}\n\n${existing}`);
  assert.equal(await editor.locator('.dsl-error').count(), 0);
  assert.equal(await page.locator('[data-class-name="ExistingClass"]').count(), 1);
  await editor.fill(`${text}\n\n${existing.replace('run(value: number)', 'execute(value: number)')}`);
  await page.waitForFunction(() => document.querySelector('[data-class-name="ExistingClass"]')?.textContent.includes('execute'));
});

