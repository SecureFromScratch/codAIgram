{
  "name": "codaigram-bridge",
  "displayName": "CodAIgram Bridge",
  "description": "A local WebSocket bridge for CodAIgram.",
  "version": "0.20.0",
  "publisher": "codaigram",
  "vsce": {
    "dependencies": false
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "CodAIgram Bridge",
      "properties": {
        "codaigramBridge.trustedOrigins": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "HTTP or HTTPS origins allowed to connect to the CodAIgram Bridge WebSocket server."
        }
      }
    },
    "commands": [
      {
        "command": "codaigram-bridge.showConnectionUrl",
        "title": "CodAIgram Bridge: Show Connection URL"
      },
      {
        "command": "codaigram-bridge.copyConnectionUrl",
        "title": "CodAIgram Bridge: Copy Connection URL"
      },
      {
        "command": "codaigram-bridge.regenerateToken",
        "title": "CodAIgram Bridge: Regenerate Connection Token"
      }
    ]
  },
  "scripts": {
    "check:gates": "untrust-buildgates --project tsconfig.json --config buildgates.json",
    "check:vv-alignment": "node scripts/check-vv-alignment.cjs",
    "bootstrap:local-vv": "node scripts/bootstrap-local-vv.cjs",
    "compile": "npm run check:vv-alignment && npm run compile:protocol && npm run check:gates && npm run compile:typescript",
    "compile:protocol": "npm --prefix ../bridge-protocol run compile",
    "compile:typescript": "tsc -p . && npm run bundle:extension && npm run bundle:validator",
    "bundle:extension": "esbuild ./test-dist/src/extension.js --bundle --platform=node --external:vscode --alias:@untrust/vv/zod=./node_modules/@untrust/vv/dist/zod/index.js --alias:@untrust/vv=./node_modules/@untrust/vv/dist/index.js --metafile=dist/extension.meta.json --outfile=dist/extension.js",
    "vscode:prepublish": "npm run compile && node scripts/bump-minor-version.cjs",
    "version": "node scripts/ensure-vsix-version.cjs",
    "package:vsix": "vsce package && node scripts/install-packaged-vsix.cjs",
    "watch": "npm run check:gates && npm run bundle:validator && tsc -watch -p .",
    "test:integration": "node ./test-dist/tests/runTest.js",
    "test": "npm run compile && npm run test:integration",
    "bundle:validator": "echo Protocol validation is compiled by bridge-protocol"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.2",
    "@untrust/buildgates": "file:../../BuildGates_ts",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^11.0.1",
    "playwright-core": "^1.65.1",
    "selfsigned": "^5.5.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@codaigram/bridge-protocol": "file:../bridge-protocol",
    "@codaigram/scan-shared": "file:../scan_shared",
    "@untrust/mandate-core": "file:../../mandate/packages/core",
    "@untrust/vv": "file:../../mandate/.artifacts/untrust-vv-0.1.16.tgz",
    "codaigram": "file:..",
    "esbuild": "^0.25.12",
    "neverthrow": "^8.2.0",
    "vite-plus": "^1.7.0",
    "ws": "^8.23.0"
  }
}
